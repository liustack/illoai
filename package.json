{
    "name": "@liustack/illoai",
    "version": "0.1.0",
    "description": "A coherent visual system for every image in an article or presentation",
    "type": "module",
    "bin": {
        "illoai": "./dist/main.js"
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "biome check src dsh",
        "format": "biome check --write src dsh",
        "check": "pnpm typecheck && pnpm lint && pnpm test",
        "prepublishOnly": "pnpm build"
    },
    "files": [
        "dist",
        "skills/illoai/SKILL.md",
        "dsh/index.js",
        "cordis.patch.yml",
        "README.md",
        "README.zh-CN.md"
    ],
    "keywords": [
        "cli",
        "illustration",
        "html-to-png",
        "playwright",
        "agent-skill",
        "illoai"
    ],
    "author": "Leon Liu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liustack/illoai.git"
    },
    "bugs": {
        "url": "https://github.com/liustack/illoai/issues"
    },
    "homepage": "https://github.com/liustack/illoai#readme",
    "engines": {
        "node": ">=22.19"
    },
    "packageManager": "pnpm@10.33.0",
    "dependencies": {
        "commander": "^13.1.0",
        "playwright": "^1.62.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/node": "^22.19.7",
        "@vitest/coverage-v8": "^3.2.7",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "^3.2.7"
    },
    "exports": {
        ".": "./dsh/index.js",
        "./dsh": "./dsh/index.js",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    }
}
